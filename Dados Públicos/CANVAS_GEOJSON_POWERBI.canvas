    {"id": "ea1b2c3d4e5f0010", "fromNode": "5e6f7a8b9c0d0004", "fromSide": "right", "toNode": "6f7a8b9c0d1e0001", "toSide": "left", "label": "Fechar e Aplicar"},
    {"id": "ea1b2c3d4e5f0011", "fromNode": "6f7a8b9c0d1e0001", "fromSide": "bottom", "toNode": "6f7a8b9c0d1e0002", "toSide": "top"},
    {"id": "ea1b2c3d4e5f0012", "fromNode": "6f7a8b9c0d1e0002", "fromSide": "bottom", "toNode": "6f7a8b9c0d1e0003", "toSide": "top"},
